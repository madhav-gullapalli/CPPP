struct Box {
    Point corner;
}
struct Point {
    int x;
}
class Owner {
    Box box;
}
struct Forest {
    List<Forest> children;
}
Point point = Point(7);
Box box = Box(point);
Owner owner = Owner(box);
Forest forest = Forest([]);
print(owner.box.corner.x, len(forest.children));
